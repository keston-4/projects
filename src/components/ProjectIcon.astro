    </svg>
  </div>
)}

{slug !== 'openclaw' && slug !== 'pihole' && slug !== 'cs2-match-analyst' && (
  <div class="icon-tile fallback">
    <svg class="icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="10" cy="10" r="3" />
    </svg>
  </div>
)}

<style>
  .icon-tile {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .icon-tile.oc {
    background: #e1f3e6;
  }
  .icon-tile.ph {
    background: oklch(96% 0.008 260);
  }
  .icon-tile.cs {
    background: oklch(93% 0.005 60);
  }
  .icon-tile.fallback {
    background: var(--accent-tint, oklch(94% 0.035 255));
    color: var(--accent, oklch(48% 0.2 255));
  }
  .icon {
    width: 24px;
    height: 24px;
  }
  .icon.pihole-logo {
    width: 17px;
    height: 25px;
  }
</style>
