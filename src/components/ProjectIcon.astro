---
// Per-project brand mark for the homepage list. Each project's real logo is
// hand-added here (slug -> markup + tile color) rather than derived
// automatically — there's no generic way to guess the right mark for a
// future project, so a new post just needs its own case added below. Unknown
// slugs fall through to a plain neutral dot rather than breaking.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---
{slug === 'openclaw' && (
  <div class="icon-tile oc">
    <svg class="icon" viewBox="0 0 120 120" fill="none">
      <defs>
        <linearGradient id="oc-lobster" x1="10" y1="5" x2="115" y2="115" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#ff4d4d" />
          <stop offset="1" stop-color="#991b1b" />
        </linearGradient>
      </defs>
      <path fill="url(#oc-lobster)" d="M60,10 C42,10 22,22 15,55 C10,78 25,95 45,100 L45,110 L52,110 L52,100 C56,101 60,101 64,100 L65,110 L72,110 L72,100 C92,95 108,78 105,55 C98,22 78,10 60,10 Z" />
      <path fill="url(#oc-lobster)" d="M20,45 C12,42 6,48 5,60 C4,68 10,72 16,68 C20,65 22,55 20,45 Z" />
      <path fill="url(#oc-lobster)" d="M100,45 C108,42 114,48 115,60 C116,68 110,72 104,68 C100,65 98,55 100,45 Z" />
      <path stroke="#ff4d4d" stroke-width="3" stroke-linecap="round" d="M45,15 Q37,10 30,8" />
      <path stroke="#ff4d4d" stroke-width="3" stroke-linecap="round" d="M75,15 Q83,10 90,8" />
      <circle cx="45" cy="35" r="6" fill="#050810" />
      <circle cx="75" cy="35" r="6" fill="#050810" />
      <circle cx="46" cy="34" r="2.5" fill="#00e5cc" />
      <circle cx="76" cy="34" r="2.5" fill="#00e5cc" />
    </svg>
  </div>
)}

{slug === 'pihole' && (
  <div class="icon-tile ph">
    <svg class="icon pihole-logo" viewBox="0 0 88.32 129.93">
      <defs>
        <linearGradient id="ph-green" x1="2.71" x2="69.77" y1="20.04" y2="20.04" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#12b212" />
          <stop offset="1" stop-color="#0f0" />
        </linearGradient>
      </defs>
      <path fill="url(#ph-green)" d="M36.56 39.93C20.34 38.2 4 25.94 2.71 0c25.17 0 38.63 14.9 39.93 38.51 4.76-28.32 27.07-25 27.07-25 1.06 16.05-12.12 25.78-27.07 26.59-4.2-8.85-29.36-30.56-29.36-30.56a.07.07 0 0 0-.11.08s24.28 21.15 23.39 30.31" />
      <path fill="#980200" d="M44.16 129.93c-1.57-.09-16.22-.65-17.11-17.11-.72-10 7.18-17.37 7.18-27.08C32.44 61.53 0 64.53 0 85.74a19.94 19.94 0 0 0 5.83 14.14L30 124.06a19.94 19.94 0 0 0 14.14 5.83" />
      <path fill="#ff0000" d="M88.32 85.75c-.09 1.57-.65 16.22-17.11 17.11-10 .72-17.38-7.18-27.08-7.18-24.21 1.79-21.21 34.22 0 34.22a19.94 19.94 0 0 0 14.14-5.83L82.46 99.9a19.94 19.94 0 0 0 5.83-14.14" />
      <path fill="#980200" d="M44.16 41.59c1.57.09 16.22.65 17.11 17.11.72 10-7.18 17.37-7.18 27.08 1.79 24.21 34.22 21.21 34.22 0a19.94 19.94 0 0 0-5.83-14.14L58.3 47.45a19.94 19.94 0 0 0-14.14-5.83" />
      <path fill="#ff0000" d="M.08 85.75c.09-1.57.65-16.22 17.11-17.11 10-.72 17.38 7.18 27.08 7.18 24.21-1.82 21.21-34.22 0-34.22a19.94 19.94 0 0 0-14.14 5.83L5.94 71.61A19.94 19.94 0 0 0 .11 85.75" />
    </svg>
  </div>
)}

{slug !== 'openclaw' && slug !== 'pihole' && (
  <div class="icon-tile fallback">
    <svg class="icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="10" cy="10" r="3" />
    </svg>
  </div>
)}

<style>
  .icon-tile {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .icon-tile.oc {
    background: #fde3e3;
  }
  .icon-tile.ph {
    background: oklch(96% 0.008 260);
  }
  .icon-tile.fallback {
    background: var(--accent-tint, oklch(94% 0.035 255));
    color: var(--accent, oklch(48% 0.2 255));
  }
  .icon {
    width: 24px;
    height: 24px;
  }
  .icon.pihole-logo {
    width: 17px;
    height: 25px;
  }
</style>
